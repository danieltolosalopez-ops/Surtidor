{
  "name": "surtidor",
  "version": "1.0.0",
  "private": true,
  "description": "Mapa de gasolineras con precios oficiales en tiempo real (España y Francia, ampliable).",
  "type": "module",
  "scripts": {
    "data": "node scripts/build-data.mjs public/data",
    "test": "node test/make-fixtures.mjs && node test/core.test.mjs && FIXTURES_DIR=test/fixtures node scripts/build-data.mjs test/out",
    "serve": "node scripts/vendor.mjs && npx --yes serve public -l 5173",
    "icons": "node scripts/make-icons.mjs",
    "vendor": "node scripts/vendor.mjs",
    "android": "node scripts/vendor.mjs && node scripts/android.mjs",
    "ios": "node scripts/vendor.mjs && node scripts/ios.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "sharp": "^0.34.0",
    "esbuild": "^0.25.0"
  },
  "dependencies": {
    "@capacitor-community/admob": "^8.0.0",
    "@capacitor/android": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/ios": "^8.0.0"
  }
}
